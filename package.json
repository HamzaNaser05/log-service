{
  "name": "log-service",
  "version": "1.0.0",
  "description": "A high-throughput log ingestion and query service built with TypeScript, Fastify, and PostgreSQL.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
