    "test": "vitest run",
    "bench:baseline": "node bench/baseline.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "fastify": "^5.11.3",
    "pg": "^8.23.0"
  }
}