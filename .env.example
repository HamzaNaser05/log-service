PORT=8080
DATABASE_URL=postgresql://log_service:log_service@localhost:5432/log_service
RETENTION_DAYS=7
PARTITION_AHEAD_DAYS=2

INGESTION_QUEUE_MAX_LOGS=25000
INGESTION_MICROBATCH_MAX_LOGS=5000
INGESTION_MICROBATCH_FLUSH_LOGS=2000
INGESTION_MICROBATCH_MAX_WAIT_MS=50
INGESTION_WRITER_COUNT=1
INGESTION_RETRY_AFTER_SECONDS=1

# Optional comma-separated browser origins for direct API access.
CORS_ORIGIN=http://localhost:3000
